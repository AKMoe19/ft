<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Sidebar နဲ့ Content ချိတ်ဆက်မှု CSS */
        .main-content {
            padding-left: 260px !important;
            width: 100% !important;
            transition: all 0.3s ease-in-out;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
        }

        .main-content.expanded {
            padding-left: 85px !important;
        }

        @media (max-width: 768px) {
            .main-content, .main-content.expanded {
                padding-left: 0 !important;
            }
        }

        .card { border-radius: 12px; }
        .table thead th { border-top: none; }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/sidebar') %>
    <%- include('partials/modal') %>

    <div class="main-content">
        <div class="container-fluid p-4" style="flex: 1;">
            
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <h2 class="fw-bold mb-0">Financial Reports</h2>
                
                <form action="/reports" method="GET" class="d-flex gap-2">
                    <select name="month" class="form-select border-0 shadow-sm" style="min-width: 130px;">
                        <% 
                            const monthNames = [
                                "January", "February", "March", "April", "May", "June",
                                "July", "August", "September", "October", "November", "December"
                            ];
                        %>
                        <% monthNames.forEach((monthName, index) => { %>
                            <option value="<%= index + 1 %>" <%= selectedMonth == (index + 1) ? 'selected' : '' %>>
                                <%= monthName %>
                            </option>
                        <% }) %>
                    </select>

                    <select name="year" class="form-select border-0 shadow-sm">
                        <% 
                            const startYear = 2024;
                            const currentYear = new Date().getFullYear();
                            const endYear = currentYear + 2;
                        %>
                        <% for(let y = startYear; y <= endYear; y++) { %>
                            <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>>
                                <%= y %>
                            </option>
                        <% } %>
                    </select>

                    <button class="btn btn-primary px-4 shadow-sm">
                        <i class="fas fa-filter me-1"></i> Filter
                    </button>
                </form>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <div class="card p-4 border-0 shadow-sm border-start border-success border-5">
                        <p class="text-muted mb-1">Total Monthly Income</p>
                        <h3 class="text-success fw-bold">+ <%= totalIncome.toLocaleString() %></h3>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card p-4 border-0 shadow-sm border-start border-danger border-5">
                        <p class="text-muted mb-1">Total Monthly Expense</p>
                        <h3 class="text-danger fw-bold">- <%= totalExpense.toLocaleString() %></h3>
                    </div>
                </div>
            </div>

            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="fw-bold mb-4 text-secondary border-bottom pb-2">
                    <i class="fas fa-list me-2"></i>Records for <%= monthNames[selectedMonth-1] %> <%= selectedYear %>
                </h5>
                
                <% if (reportData.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Title & Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reportData.forEach(r => { %>
                                <tr>
                                    <td class="py-3">
                                        <span class="fw-bold d-block text-dark"><%= r.title %></span>
                                        <small class="text-muted">
                                            <i class="far fa-calendar-alt me-1"></i> <%= r.date.toDateString() %>
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold <%= r.type === 'income' ? 'text-success' : 'text-danger' %>">
                                        <%= r.type === 'income' ? '+' : '-' %> <%= r.amount.toLocaleString() %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-folder-open fa-3x text-light mb-3"></i>
                        <p class="text-muted">ဤလအတွက် စာရင်းများ မရှိသေးပါ။</p>
                    </div>
                <% } %>
            </div>
        </div>

        <%- include('partials/footer') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>