<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - My Wallet</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .settings-card { border-radius: 12px; border: none; }
        .form-control { border-radius: 8px; padding: 10px 15px; }
        .btn-update { border-radius: 8px; padding: 10px 25px; font-weight: 600; }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="container-fluid p-4">
            <h3 class="fw-bold mb-4">Account Settings</h3>

            <% if (message) { %>
                <div class="alert alert-<%= message.type %> alert-dismissible fade show mb-4" role="alert">
                    <i class="fas <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> me-2"></i>
                    <%= message.text %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="row">

                <div class="col-lg-8">
                    <div class="card settings-card shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4"><i class="fas fa-user-edit me-2 text-primary"></i>Profile Information</h5>
                            <form action="/settings/update-profile" method="POST">
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Username</label>
                                    <input type="text" class="form-control bg-light" name="username" value="<%= user.username %>" required>
                                </div>
                                <button type="submit" class="btn btn-primary btn-update">Update Profile</button>
                            </form>
                        </div>
                    </div>

                    <div class="card settings-card shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4"><i class="fas fa-lock me-2 text-danger"></i>Security & Password</h5>
                            <form action="/settings/update-password" method="POST">
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Current Password</label>
                                    <input type="password" class="form-control" name="currentPassword" placeholder="••••••••" required>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-muted small fw-bold">New Password</label>
                                    <input type="password" class="form-control" name="newPassword" placeholder="အနည်းဆုံး ၆ လုံး" required minlength="6">
                                </div>
                                <button type="submit" class="btn btn-danger btn-update">Change Password</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 bg-primary text-white p-4 rounded-4 shadow-sm">
                        <h5 class="text-center">လုံခြုံရေးအတွက် အကြံပြုချက်</h5>
                        <hr>
                        <p class="small opacity-75 mb-0">သင့်အကောင့်ကို ပိုမိုလုံခြုံစေရန်အတွက် Password ကို ခက်ခဲသော စာလုံး၊ ဂဏန်းများ ရောနှောအသုံးပြုပါ။ Password လဲလှယ်ပြီးပါက မှတ်သားထားရန် မမေ့ပါနှင့်။</p>
                    </div>
                </div>

            </div>
        </div>

        <%- include('partials/footer') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>