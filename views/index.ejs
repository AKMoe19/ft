<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Sidebar နဲ့ ချိတ်ဆက်ဖို့အတွက် CSS */
        .main-content {
            padding-left: 260px !important; /* Sidebar width */
            width: 100% !important;
            transition: all 0.3s ease-in-out;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar ချုံ့လိုက်ချိန်မှာ Content ကို ဘယ်ဘက်ကပ်သွားစေရန် */
        .main-content.expanded {
            padding-left: 85px !important;
        }

        /* Mobile View မှာ Padding ကို ဖျောက်ရန် */
        @media (max-width: 768px) {
            .main-content, .main-content.expanded {
                padding-left: 0 !important;
            }
        }

        /* Card တွေ ပိုလှအောင် Styling အနည်းငယ်ထည့်ခြင်း */
        .card { border-radius: 12px; }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/sidebar') %>
    <%- include('partials/modal') %>

    <div class="main-content">
        <div class="container-fluid p-4" style="flex: 1;">
            <h2 class="fw-bold mb-4">Dashboard Overview</h2>
            
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card p-3 border-0 shadow-sm border-start border-success border-5">
                        <small class="text-muted">Income</small>
                        <h3 class="text-success fw-bold">+ <%= income.toLocaleString() %></h3>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card p-3 border-0 shadow-sm border-start border-danger border-5">
                        <small class="text-muted">Expense</small>
                        <h3 class="text-danger fw-bold">- <%= expense.toLocaleString() %></h3>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card p-3 border-0 shadow-sm bg-dark text-white">
                        <small class="opacity-75">Net Balance</small>
                        <h3 class="fw-bold"><%= (income - expense).toLocaleString() %></h3>
                    </div>
                </div>
            </div>

            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="mb-4 fw-bold text-secondary">Monthly Analysis</h5>
                <canvas id="analysisChart" style="max-height: 350px;"></canvas>
            </div>
        </div>

        <%- include('partials/footer') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const chartData = <%- JSON.stringify(chartData) %>;
        const ctx = document.getElementById('analysisChart').getContext('2d');

        new Chart(ctx, {
            type: 'line', // Line Chart ပုံစံ
            data: {
                labels: chartData.map(d => d._id),
                datasets: [
                    { 
                        label: 'Income', 
                        data: chartData.map(d => d.income), 
                        borderColor: '#198754', 
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3
                    },
                    { 
                        label: 'Expense', 
                        data: chartData.map(d => d.expense), 
                        borderColor: '#dc3545', 
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>
