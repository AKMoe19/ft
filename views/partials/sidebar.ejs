                        <a class="dropdown-item rounded-2 py-2 text-danger fw-bold" href="/logout">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>

        </li>        
        
    </ul>
    
</div>

<style>
    /* Dropdown Hover Effect */
    .dropdown-item:hover {
        background-color: rgba(13, 110, 253, 0.2) !important;
        color: #0d6efd !important;
    }
    
    /* Desktop Sidebar ပုံမှန် Width */
    .sidebar {
        width: 260px !important;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        transition: width 0.3s ease;
        z-index: 9999;
        overflow: hidden;
    }

    .dropdown-menu{
        z-index: 9999 !important;
        position: fixed !important;
    }

    /* Mini Sidebar ဖြစ်သွားရင် 85px ပဲထားမယ် */
    .sidebar.mini {
        width: 85px !important;
    }

    .sidebar.mini .sidebar-text {
        display: none !important;
    }

    
    .main-content {
        padding-left: 260px !important;
        width: 100% !important;
        transition: padding-left 0.3s ease;
    }

    /* Sidebar သေးသွားရင် Content ကို ဘယ်ဘက် တွန်းကပ်လိုက်မယ် */
    .main-content.expanded {
        padding-left: 85px !important; /* နေရာလွတ် မကျန်အောင် 85px ပဲ ထားမယ် */
    }

    /* Mobile View */
    @media (max-width: 768px) {
        .sidebar { left: -260px !important; width: 260px !important; }
        .sidebar.active { left: 0 !important; }
        .main-content, .main-content.expanded { padding-left: 0 !important; }
    }
</style>

<script>
    function toggleSidebar(e) {
        if(e) e.stopPropagation();
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('.main-content');
        
        if (window.innerWidth > 768) {
            sidebar.classList.toggle('mini');
            if(mainContent) mainContent.classList.toggle('expanded');
        } else {
            sidebar.classList.toggle('active');
        }
    }
</script>
