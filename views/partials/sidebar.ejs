        </button>
    </div>

    <ul class="nav flex-column h-100">
        <li class="nav-item mb-2">
            <a href="/" class="nav-link text-white <%= page === 'dashboard' ? 'active bg-primary' : '' %> rounded px-3">
                <i class="fas fa-th-large"></i>
                <span class="sidebar-text ms-3">Dashboard</span>
            </a>
        </li>
        <li class="nav-item mb-2">
            <a href="/history" class="nav-link text-white <%= page === 'history' ? 'active bg-primary' : '' %> rounded px-3">
                <i class="fas fa-history"></i>
                <span class="sidebar-text ms-3">History</span>
            </a>
        </li>
        <li class="nav-item mb-2">
            <a href="/reports" class="nav-link text-white <%= page === 'reports' ? 'active bg-primary' : '' %> rounded px-3">
                <i class="fas fa-chart-pie"></i>
                <span class="sidebar-text ms-3">Reports</span>
            </a>
        </li>

        <hr>

        <button class="btn btn-outline-secondary w-100 py-2 rounded-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#addModal">
            <i class="fas fa-plus"></i>
            <span class="sidebar-text ms-2">New Entry</span>
        </button>


        <li class="mt-auto mb-5">

            <div class="dropdown mt-2 mb-3">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 32px; height: 32px;">
                        <i class="fas fa-user-astronaut text-white small"></i>
                    </div>
                    <strong class="sidebar-text"><%= typeof user !== 'undefined' ? user.username : 'User' %></strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow border-0" aria-labelledby="dropdownUser1" style="border-radius: 12px; padding: 10px;">
