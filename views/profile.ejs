<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Info - MyWallet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .profile-card { border-radius: 15px; border: none; overflow: hidden; }
        .profile-header { background: linear-gradient(45deg, #0d6efd, #00d2ff); height: 100px; }
        .avatar-box { margin-top: -50px; }
        .stat-card { border-radius: 12px; border-left: 5px solid #0d6efd; }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="container-fluid p-4">
            <h3 class="fw-bold mb-4">Account Information</h3>

            <div class="row">
                <div class="col-lg-4 mb-4">
                    <div class="card profile-card shadow-sm text-center pb-4">
                        <div class="profile-header"></div>
                        <div class="avatar-box mb-3">
                            <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px;">
                                <i class="fas fa-user-astronaut fa-3x text-primary"></i>
                            </div>
                        </div>
                        <h4 class="fw-bold"><%= user.username %></h4>
                        <p class="text-muted small">Standard User</p>
                        <hr class="mx-4 opacity-25">
                        <div class="px-4 text-start">
                            <label class="text-muted small">User ID:</label>
                            <p class="fw-bold"><%= user._id %></p>
                            <label class="text-muted small">Member Since:</label>
                            <p class="fw-bold">April 2026</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card stat-card shadow-sm p-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3 text-success">
                                        <i class="fas fa-arrow-up"></i>
                                    </div>
                                    <div>
                                        <p class="text-muted mb-0 small">Lifetime Income</p>
                                        <h4 class="fw-bold mb-0">+ <%= stats.income.toLocaleString() %></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card stat-card shadow-sm p-3 border-danger">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3 text-danger">
                                        <i class="fas fa-arrow-down"></i>
                                    </div>
                                    <div>
                                        <p class="text-muted mb-0 small">Lifetime Expense</p>
                                        <h4 class="fw-bold mb-0">- <%= stats.expense.toLocaleString() %></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 mt-4">
                            <div class="card border-0 shadow-sm p-4 rounded-4">
                                <h5 class="fw-bold mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Account Details</h5>
                                <div class="table-responsive">
                                    <table class="table table-borderless align-middle mb-0">
                                        <tbody>
                                            <tr class="border-bottom">
                                                <td class="py-3 text-muted">Account Status</td>
                                                <td class="py-3 text-end"><span class="badge bg-success-subtle text-success px-3">Active</span></td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <td class="py-3 text-muted">Total Transactions</td>
                                                <td class="py-3 text-end fw-bold"><%= stats.count %> Records</td>
                                            </tr>
                                            <tr>
                                                <td class="py-3 text-muted">Current Balance</td>
                                                <td class="py-3 text-end fw-bold text-primary fs-5"><%= stats.balance.toLocaleString() %> MMK</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>